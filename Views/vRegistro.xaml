<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaExamem.Views.vRegistro"
             Title="Registro">

    <ContentPage.Resources>
        <!-- Estilo para el título: azul, tamaño 22, centrado -->
        <Style x:Key="styleTitulo" TargetType="Label">
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <!-- Usuario conectado -->
            <Label x:Name="lblUsuario"
                   HorizontalTextAlignment="End"/>

            <!-- Título -->
            <Label Text="REGISTRO"
                   Style="{StaticResource styleTitulo}"/>

            <Grid RowSpacing="10" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Nombre"
                       Grid.Row="0"
                       Grid.Column="0"/>
                <Entry x:Name="txtNombre"
                       Placeholder="Ingresar Nombre"
                       Grid.Row="1"
                       Grid.Column="0"/>

                <Label Text="Apellido"
                       Grid.Row="0"
                       Grid.Column="1"/>
                <Entry x:Name="txtApellido"
                       Placeholder="Ingresar Apellido"
                       Grid.Row="1"
                       Grid.Column="1"/>

                <Label Text="Edad"
                       Grid.Row="0"
                       Grid.Column="2"/>
                <Entry x:Name="txtEdad"
                       Placeholder="Ingresar Edad"
                       Keyboard="Numeric"
                       MaxLength="3"
                       Grid.Row="1"
                       Grid.Column="2"/>
            </Grid>

            <Grid RowSpacing="10" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Fecha de inicio -->
                <Label Text="Fecha de inicio"
                       VerticalOptions="Center"
                       Grid.Row="0"
                       Grid.Column="0"/>
                <DatePicker x:Name="dpFechaInicio"
                            Format="dd/MM/yyyy"
                            Grid.Row="0"
                            Grid.Column="1"/>

                <!-- Plan -->
                <Label Text="Plan"
                       VerticalOptions="Center"
                       Grid.Row="1"
                       Grid.Column="0"/>
                <Picker x:Name="pkPlan"
                        Title="Seleccione el plan"
                        Grid.Row="1"
                        Grid.Column="1"/>

                <!-- Casillero -->
                <Label Text="Casillero"
                       VerticalOptions="Center"
                       Grid.Row="2"
                       Grid.Column="0"/>
                <Switch x:Name="swCasillero"
                        HorizontalOptions="Start"
                        Grid.Row="2"
                        Grid.Column="1"/>

                <!-- Monto inicial (entre 120 y 600) -->
                <Label Text="Monto Inicial"
                       VerticalOptions="Center"
                       Grid.Row="3"
                       Grid.Column="0"/>
                <Entry x:Name="txtMontoInicial"
                       Placeholder="Entre 120 y 600"
                       Keyboard="Numeric"
                       Grid.Row="3"
                       Grid.Column="1"/>

                <!-- Pago mensual bloqueado -->
                <Button x:Name="btnCalcular"
                        Style="{StaticResource styleBotonGlobal}"
                        Text="Calcular Pago mensual"
                        Clicked="btnCalcular_Clicked"
                        Grid.Row="4"
                        Grid.Column="0"/>
                <Entry x:Name="txtPagoMensual"
                       Placeholder="Pago mensual"
                       IsReadOnly="True"
                       Grid.Row="4"
                       Grid.Column="1"/>
            </Grid>

            <!-- Fuera del Grid -->
            <Button x:Name="btnVerResumen"
                    Style="{StaticResource styleBotonGlobal}"
                    Text="Ver Resumen"
                    Clicked="btnVerResumen_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
