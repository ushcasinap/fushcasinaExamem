<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaExamem.Views.vLogin"
             Title="Login">

  
    <VerticalStackLayout
        Padding="20"
        Spacing="10">

  
        <Image Source="logo1.jpeg"
               WidthRequest="150"
               HorizontalOptions="Center"/>

        <Label Text="GIMNASIO - INICIO DE SESIÓN"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"/>

   
        <Grid RowSpacing="10" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

          
            <Label Text="Usuario:"
                   VerticalOptions="Center"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Entry x:Name="txtUsuario"
                   Placeholder="Ingrese el usuario"
                   Grid.Row="0"
                   Grid.Column="1"/>

          
            <Label Text="Contraseña:"
                   VerticalOptions="Center"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Entry x:Name="txtContrasenia"
                   Placeholder="Ingrese la contraseña"
                   IsPassword="True"
                   Grid.Row="1"
                   Grid.Column="1"/>

            <Button x:Name="btnIniciarSesion"
                    Text="Iniciar sesión"
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>
            <Button x:Name="btnAcercaDe"
                    Text="Acerca de"
                    Clicked="btnAcercaDe_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"/>
        </Grid>

    </VerticalStackLayout>

</ContentPage>