<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaExamem.Views.vAcercaDe"
             Title="Acerca de">

    <VerticalStackLayout
        Padding="20"
        Spacing="10">

        <Label Text="ACERCA DE"
               HorizontalOptions="Center"/>

        <!-- Grid 3 filas x 2 columnas con la información del estudiante -->
        <Grid RowSpacing="10" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Text="Nombre:"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Label Text="TU NOMBRE COMPLETO"
                   Grid.Row="0"
                   Grid.Column="1"/>

            <Label Text="Carrera:"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Label Text="TU CARRERA"
                   Grid.Row="1"
                   Grid.Column="1"/>

            <Label Text="Paralelo:"
                   Grid.Row="2"
                   Grid.Column="0"/>
            <Label Text="TU PARALELO"
                   Grid.Row="2"
                   Grid.Column="1"/>
        </Grid>

        <Button x:Name="btnRegresar"
                Style="{StaticResource styleBotonGlobal}"
                Text="Regresar"
                Clicked="btnRegresar_Clicked"/>

    </VerticalStackLayout>

</ContentPage>
